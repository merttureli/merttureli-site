{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|disabled|trailing|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, disabled, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|ghost|glass|link)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'ghost' | 'glass' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|index|align|key|ref|className|style|children)$/]",
        "message": "<Caption> doesn't accept that prop. Declared props: children, index, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Caption> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|level|as|treatment|weight|caps|key|ref|className|style|children)$/]",
        "message": "<DisplayHeading> doesn't accept that prop. Declared props: children, level, as, treatment, weight, caps."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayHeading'] > JSXAttribute[name.name='treatment'] > Literal[value!=/^(?:solid|outline|inverse)$/]",
        "message": "<DisplayHeading> treatment must be one of 'solid' | 'outline' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grain'] > JSXAttribute > JSXIdentifier[name!=/^(?:strength|blend|key|ref|className|style|children)$/]",
        "message": "<Grain> doesn't accept that prop. Declared props: strength, blend."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grain'] > JSXAttribute[name.name='strength'] > Literal[value!=/^(?:subtle|normal|strong)$/]",
        "message": "<Grain> strength must be one of 'subtle' | 'normal' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grain'] > JSXAttribute[name.name='blend'] > Literal[value!=/^(?:multiply|overlay|soft-light|normal)$/]",
        "message": "<Grain> blend must be one of 'multiply' | 'overlay' | 'soft-light' | 'normal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|inverse|opacity|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, inverse, opacity."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|radius|fit|scrim|grain|hoverZoom|index|caption|children|key|ref|className|style|children)$/]",
        "message": "<MediaFrame> doesn't accept that prop. Declared props: src, alt, ratio, radius, fit, scrim, grain, hoverZoom, index, caption, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:cover|contain)$/]",
        "message": "<MediaFrame> fit must be one of 'cover' | 'contain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:none|hero|bottom|flat)$/]",
        "message": "<MediaFrame> scrim must be one of 'none' | 'hero' | 'bottom' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meta'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|index|tone|mono|wide|key|ref|className|style|children)$/]",
        "message": "<Meta> doesn't accept that prop. Declared props: children, index, tone, mono, wide."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meta'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:meta|muted|body|strong)$/]",
        "message": "<Meta> tone must be one of 'meta' | 'muted' | 'body' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|active|inverse|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: children, href, active, inverse."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|inverse|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, attribution, inverse."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|right|strong|spacing|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: label, right, strong, spacing."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollCue'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|inverse|shape|onClick|key|ref|className|style|children)$/]",
        "message": "<ScrollCue> doesn't accept that prop. Declared props: label, inverse, shape, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollCue'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|bare)$/]",
        "message": "<ScrollCue> shape must be one of 'square' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeaderItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|key|ref|className|style|children)$/]",
        "message": "<SiteHeaderItem> doesn't accept that prop. Declared props: id, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|inverse|variant|onPrev|onNext|onSelect|key|ref|className|style|children)$/]",
        "message": "<SlideCounter> doesn't accept that prop. Declared props: current, total, inverse, variant, onPrev, onNext, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideCounter'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:fraction|steps|dots)$/]",
        "message": "<SlideCounter> variant must be one of 'fraction' | 'steps' | 'dots'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialRailItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|icon|href|key|ref|className|style|children)$/]",
        "message": "<SocialRailItem> doesn't accept that prop. Declared props: name, icon, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|aside|key|ref|className|style|children)$/]",
        "message": "<SpecRow> doesn't accept that prop. Declared props: label, value, aside."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|inverse|as|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: name, size, weight, inverse, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Wordmark> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|discipline|year|src|alt|ratio|href|key|ref|className|style|children)$/]",
        "message": "<WorkCard> doesn't accept that prop. Declared props: index, title, discipline, year, src, alt, ratio, href."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
