// {{WORD}}: a showreel project actor.
// Generated by `python3 tools/new.py actor {{KEY}}`. Edit freely. Recipe: docs/recipes/showreel-actor.md
//
// Three pieces, the same split Therma-Shift uses (coaster.js is the object,
// props.js the extras, the actor in index.js its part of the reel):
//
//   createModel({ THREE, renderer, quality }) -> the object itself
//     group, height, footprint, triangles
//     getParts()      [{ name, mesh, explode }] in build order; mesh is the part's Group
//     setProgress(p)  0 = exploded, 1 = assembled; a pure function of p
//     setDrive(x)     -1..1, the one mechanism that moves (arm, pedals, rudder)
//     update(dt, time), dispose()
//     Today: PLACEHOLDER boxes built from PARTS below. Later: the CAD import
//     (docs/design/3d.md, tools/cad.py). Keep the part names and this API and
//     nothing else in this file has to change.
//
//   createAccent({ THREE }) -> the second thing the reel animates
//     (Robo-Catcher: the yellow-green ball; rudder pedals: the small plane)
//     group, dispose(). PLACEHOLDER sphere.
//
//   createActor(ctx) -> the reel actor, the "project actor interface" at the
//     top of next/js/showreel/index.js:
//     group, sequence, layout(frame), sample(T, states), beginAbort(),
//     sampleAbort(u), reset(), update(dt, time), prewarm(renderer, camera,
//     scene), visible, dispose()
//
// Units meters, +Y up, model origin at the center of its footprint on the
// ground. Lights and environment come from engine.js (engine.adopt): never
// add lights, fog or an environment here.
//
// Register (one line in next/js/showreel/index.js, under the Therma-Shift
// registerProject call; it loads lazily, so a broken actor never breaks the
// hero, and the word must match a .drift <i> in next/index.html):
//   registerProject({ key: '{{KEY}}', word: '{{WORD}}', actor: ctx => import('./{{KEY}}.js').then(m => m.createActor(ctx)) });
// Preview without registering: next/lab/{{KEY}}.html
import { THREE, ease, win, clamp01, lerp, placeInFrame, screenExtents } from './engine.js';

export const KEY = '{{KEY}}';
export const WORD = '{{WORD}}';

// ================================================================ EDIT: reel
// [STATE, seconds], played between ROCKET_EXIT (2.1 s) and ROCKET_RETURN
// (2.6 s). Names must be unique in the whole reel, hence the prefix. Keep the
// order (sample() reads them by position) or update sample() to match.
export const SEQUENCE = [
  ['{{PREFIX}}_ENTER', 2.2],     // parts fly in from off screen, exploded
  ['{{PREFIX}}_ASSEMBLE', 2.6],  // exploded -> assembled
  ['{{PREFIX}}_ACTION', 5.0],    // the mechanism works: drive + accent
  ['{{PREFIX}}_EXIT', 2.0],      // pops open, parts fly out
];
const [ENTER, ASSEMBLE, ACTION, EXIT] = SEQUENCE.map(s => s[0]);

// ============================================================ EDIT: the look
// Matte and satin only, values from coaster.js (docs/design/3d.md has the
// full palette). Keys are referenced by PARTS[].mat.
const MATERIALS = {
  shell: { color: 0x6d717c, roughness: .74, metalness: 0 },   // matte grey plastic
  metal: { color: 0xd3d7dd, roughness: .4, metalness: .6 },   // satin aluminium
  steel: { color: 0xbfc3c8, roughness: .34, metalness: .9 },  // fasteners, shafts
  dark: { color: 0x17181b, roughness: .5, metalness: 0 },     // black parts
};
// Viewing angle of the whole object (radians): a three-quarter view from above.
const VIEW = { x: .4, y: -.62 };
// How big it sits in the hero's free area: [landscape, portrait].
const FRAME = { share: [.3, .44], fillW: [.4, .8], fillH: [.84, .56], prefer: [.54, .5] };

// ============================================= EDIT: the parts (PLACEHOLDER)
// One row per part, in build order. `name` becomes the getParts() name and
// must match the CAD part name later. size: box [w, h, d] or cyl [radius,
// height]; at: assembled center; explode: offset added at p = 0 (exploded
// view). drive: the part setDrive() turns, about `pivot` on `axis` by
// +-`range` radians. dir: screen direction it flies in from, degrees (0 =
// right, 90 = up); leave it out for an automatic spread.
const PARTS = [
  { name: 'base', shape: 'box', size: [.16, .012, .12], at: [0, .006, 0], mat: 'dark', explode: [0, -.04, 0], dir: -80 },
  { name: 'body', shape: 'box', size: [.07, .08, .07], at: [0, .052, 0], mat: 'shell', explode: [0, .015, 0], dir: 200 },
  { name: 'cap', shape: 'cyl', size: [.024, .012], at: [0, .098, 0], mat: 'steel', explode: [0, .1, 0], dir: 100 },
  { name: 'arm', shape: 'box', size: [.12, .012, .022], at: [.045, .11, 0], mat: 'metal', explode: [.05, .16, 0], dir: 30,
    drive: { axis: 'y', range: .7, pivot: [0, .11, 0] } },
];

// The accent (PLACEHOLDER): flies in during ACTION and comes to rest at
// `rest` (model space), arriving from screen direction `from` (degrees) over
// an arc `arc` meters high.
const ACCENT = { color: 0xc5d93a, roughness: .62, metalness: 0, radius: .02, rest: [.1, .128, 0], from: 150, arc: .08 };

// ==================================================================== model
export function createModel({ THREE: T = THREE, quality = 'high' } = {}) {
  const seg = quality === 'low' ? 16 : 32;
  const group = new T.Group();
  group.name = KEY;
  const geos = [], mats = {};
  const mat = k => mats[k] || (mats[k] = new T.MeshStandardMaterial(MATERIALS[k]));
  const list = PARTS.map(row => {
    const geo = row.shape === 'cyl'
      ? new T.CylinderGeometry(row.size[0], row.size[0], row.size[1], seg)
      : new T.BoxGeometry(row.size[0], row.size[1], row.size[2]);
    geos.push(geo);
    const pivot = new T.Vector3(...((row.drive && row.drive.pivot) || row.at));
    const holder = new T.Group();
    holder.name = row.name;
    const mesh = new T.Mesh(geo, mat(row.mat));
    mesh.position.set(row.at[0] - pivot.x, row.at[1] - pivot.y, row.at[2] - pivot.z);
    holder.add(mesh);
    group.add(holder);
    return { name: row.name, mesh: holder, rest: pivot, explode: new T.Vector3(...row.explode), drive: row.drive || null, dir: row.dir };
  });
  const box = new T.Box3().setFromObject(group), size = box.getSize(new T.Vector3());

  // Staggered arrivals in build order: part i lands over its own window.
  function setProgress(p) {
    const n = list.length;
    list.forEach((P, i) => {
      const a = n > 1 ? i / (n - 1) * .5 : 0, k = ease.inOutSine(win(p, a, a + .5));
      P.mesh.position.copy(P.rest).addScaledVector(P.explode, 1 - k);
    });
  }
  function setDrive(x) {
    const c = Math.max(-1, Math.min(1, x));
    for (const P of list) if (P.drive) P.mesh.rotation[P.drive.axis] = c * P.drive.range;
  }
  setProgress(1);
  return {
    group, height: size.y, footprint: Math.max(size.x, size.z),
    triangles: geos.reduce((s, g) => s + (g.index ? g.index.count : g.attributes.position.count) / 3, 0),
    getParts: () => list.map(({ name, mesh, explode, dir }) => ({ name, mesh, explode, dir })),
    setProgress, setDrive,
    update() {},
    dispose() { for (const g of geos) g.dispose(); for (const k in mats) mats[k].dispose(); },
  };
}

// =================================================================== accent
export function createAccent({ THREE: T = THREE, quality = 'high' } = {}) {
  const geo = new T.SphereGeometry(ACCENT.radius, quality === 'low' ? 16 : 32, quality === 'low' ? 12 : 24);
  const material = new T.MeshStandardMaterial({ color: ACCENT.color, roughness: ACCENT.roughness, metalness: ACCENT.metalness });
  const group = new T.Group();
  group.name = KEY + ':accent';
  group.add(new T.Mesh(geo, material));
  return { group, dispose() { geo.dispose(); material.dispose(); } };
}

// ==================================================================== actor
export async function createActor(ctx) {
  const { engine, quality = 'high' } = ctx;
  const base = { THREE, renderer: engine.renderer, quality };
  const model = createModel(base);
  const accent = createAccent(base);

  // stage (placed and scaled by layout) > view (viewing angle) > model, accent, shadow
  const stage = new THREE.Group(), view = new THREE.Group();
  stage.name = KEY + ':stage';
  stage.add(view);
  view.rotation.set(VIEW.x, VIEW.y, 0);
  view.add(model.group, accent.group);
  const shadow = contactShadow(model.footprint * 1.7);
  shadow.position.y = .0005;
  view.add(shadow);
  stage.visible = false;
  stage.updateMatrixWorld(true);

  // Screen direction (degrees) -> a direction in view space, slightly toward camera.
  const inv = new THREE.Quaternion().copy(view.quaternion).invert();
  const screenDir = deg => new THREE.Vector3(Math.cos(deg * Math.PI / 180), Math.sin(deg * Math.PI / 180), .18).normalize().applyQuaternion(inv);

  // Wrap each part in a pivot group so the reel flies it in and out without
  // touching the model's own setProgress transforms.
  const parts = model.getParts().map((p, i) => {
    const mesh = p.mesh, wrap = new THREE.Group();
    mesh.parent.add(wrap); wrap.add(mesh);
    const axis = new THREE.Vector3(Math.sin(i * 2.1 + 1), Math.cos(i * 1.7), Math.sin(i * 3.3 + 2)).normalize();
    return { name: p.name, mesh, wrap, axis, dir: screenDir(p.dir ?? (i * 137.5 + 30)), spin: (i % 2 ? -1 : 1) * (.7 + (i * .37) % .6), delay: ((i * .618) % 1) * .32, f: 1, f0: 1 };
  });
  const accRest = new THREE.Vector3(...ACCENT.rest), accIn = screenDir(ACCENT.from), accOut = screenDir(ACCENT.from - 180 + 40);
  const up = new THREE.Vector3(0, 1, 0);

  const REST = { p: 0, drive: 0, acc: 0, accOut: 0, shadow: 0 };
  const v = { ...REST }, a0 = { ...REST };   // live values, values captured at abort
  let dist = 2;                               // local units that put a part well off screen
  const q = new THREE.Quaternion(), tmp = new THREE.Vector3(), piv = new THREE.Vector3();

  function apply() {
    model.setProgress(v.p);
    model.setDrive(v.drive);
    let any = false;
    for (const P of parts) {
      if (P.f < .999) any = true;
      q.setFromAxisAngle(P.axis, P.spin * P.f);
      piv.copy(P.mesh.position);
      tmp.copy(piv).applyQuaternion(q);
      P.wrap.quaternion.copy(q);
      P.wrap.position.copy(P.dir).multiplyScalar(dist * P.f * (1 + P.delay)).add(piv).sub(tmp);
    }
    const accVisible = v.acc > .001 && v.accOut < .999;
    accent.group.visible = accVisible;
    if (accVisible) {
      accent.group.position.copy(accRest)
        .addScaledVector(accIn, dist * (1 - v.acc))
        .addScaledVector(up, ACCENT.arc * Math.sin(Math.PI * v.acc))
        .addScaledVector(accOut, dist * v.accOut);
    }
    shadow.material.opacity = .42 * v.shadow;
    stage.visible = any || accVisible;
  }

  // Framing: size the object to a share of the hero's free area and place it
  // clear of the focused drift word. Measures assembled AND exploded, so the
  // open stack fits too. Runs on resize only.
  function layout(F) {
    const { halfW, halfH, camera, w, h, free, avoid } = F;
    const n = w < h ? 1 : 0;
    const keep = parts.map(P => P.f), kv = { ...v };
    for (const P of parts) P.f = 0;
    let S = 2 * Math.min(halfW, halfH) * FRAME.share[n] / Math.max(model.footprint, model.height, .01);
    stage.scale.setScalar(S); stage.position.set(0, 0, 0);
    Object.assign(v, { p: 1, acc: 1, accOut: 0 }); apply();
    const e1 = screenExtents([model.group, accent.group], stage, camera, w, h);
    v.p = 0; apply();
    const e0 = screenExtents([model.group], stage, camera, w, h);
    const ext = { l: Math.max(e0.l, e1.l), r: Math.max(e0.r, e1.r), u: Math.max(e0.u, e1.u), d: Math.max(e0.d, e1.d) };
    const fw = free.r - free.l, fh = free.b - free.t;
    let k = Math.min(fh * FRAME.fillH[n] / (ext.u + ext.d), fw * FRAME.fillW[n] / (ext.l + ext.r));
    const prefer = { x: free.l + fw * FRAME.prefer[0], y: free.t + fh * FRAME.prefer[1] };
    let spot = null;
    for (let i = 0; i < 5 && !spot; i++, k *= .9) {
      const e = { l: ext.l * k, r: ext.r * k, u: ext.u * k, d: ext.d * k };
      spot = placeInFrame({ ext: e, free, avoid, prefer: { x: prefer.x - (e.r - e.l) / 2, y: prefer.y - (e.d - e.u) / 2 } });
    }
    if (spot) k /= .9;
    S *= k;
    stage.scale.setScalar(S);
    const ox = spot ? spot.x : w / 2, oy = spot ? spot.y : h / 2;
    stage.position.set((ox / w * 2 - 1) * halfW, (1 - oy / h * 2) * halfH, 0);
    dist = Math.hypot(halfW, halfH) * 1.3 / S;
    parts.forEach((P, i) => { P.f = keep[i]; });
    Object.assign(v, kv);
    apply();
  }

  // ======================================================== EDIT: the motion
  // The reel as a pure function of T (reel seconds) and the state windows
  // S[NAME] = { t0, t1 }. No dt, no accumulated state: the reel seeks.
  function sample(T, S) {
    const E = S[ENTER], A = S[ASSEMBLE], X = S[ACTION], O = S[EXIT];
    const uIn = win(T, E.t0 - .4, E.t1);
    let fin = 0, fout = 0;
    for (const P of parts) {
      const inn = ease.outQuart(win(uIn, P.delay, P.delay + .68));
      const out = ease.inCubic(win(T, O.t0 + .3 + P.delay * 1.4, O.t1));
      P.f = (1 - inn) + out;
      fin += inn; fout += out;
    }
    const n = parts.length || 1;
    const pop = ease.outCubic(win(T, O.t0, O.t0 + .6));        // reopens before leaving
    v.p = ease.inOutSine(win(T, A.t0 - .2, A.t1)) * (1 - pop);
    const u = win(T, X.t0, X.t1);
    // PLACEHOLDER mechanism: the arm swings out to meet the accent, catches it, settles
    v.drive = -Math.sin(Math.PI * win(u, 0, .6)) * .6 + .25 * Math.sin(Math.PI * win(u, .6, .85));
    v.acc = ease.inOutSine(win(u, .08, .6));
    v.accOut = ease.inCubic(win(T, O.t0 + .1, O.t0 + 1.2));
    v.shadow = Math.min(fin / n, 1 - fout / n) * (.35 + .65 * v.p);
    apply();
  }

  // Leave gracefully from wherever the reel is (any scroll or input). u 0..1.
  function beginAbort() {
    Object.assign(a0, v);
    for (const P of parts) P.f0 = P.f;
  }
  function sampleAbort(u) {
    let fin = 0;
    for (const P of parts) {
      P.f = lerp(P.f0, Math.max(P.f0, 1.05), ease.inCubic(win(u, P.delay * .5, .8 + P.delay * .5)));
      fin += clamp01(1 - P.f);
    }
    v.p = a0.p * (1 - ease.outCubic(win(u, 0, .45)));
    v.drive = a0.drive * (1 - ease.outCubic(win(u, 0, .4)));
    v.acc = a0.acc;
    v.accOut = lerp(a0.accOut, 1, ease.inCubic(win(u, 0, .7)));
    v.shadow = Math.min(a0.shadow, fin / (parts.length || 1));
    apply();
  }

  // Compile every shader and upload every texture before the first run, so
  // nothing stalls mid-reel.
  async function prewarm(renderer, camera, scene) {
    const hidden = [];
    for (const P of parts) P.f = 0;
    Object.assign(v, { p: 1, drive: 0, acc: 1, accOut: 0, shadow: 1 });
    apply();
    stage.traverse(o => { if (!o.visible) { hidden.push(o); o.visible = true; } });
    try { await renderer.compileAsync(stage, camera, scene); } catch (e) { /* compiles on first draw instead */ }
    const seen = new Set();
    const upload = t => { if (t && t.isTexture && !seen.has(t)) { seen.add(t); renderer.initTexture(t); } };
    stage.traverse(o => { for (const m of [].concat(o.material || [])) for (const k in m) upload(m[k]); });
    for (const o of hidden) o.visible = false;
    reset();
  }
  function reset() { for (const P of parts) P.f = 1; Object.assign(v, REST); apply(); }
  function update(dt, time) { if (stage.visible && model.update) model.update(dt, time); }

  reset();
  engine.adopt(stage);
  return {
    group: stage, sequence: SEQUENCE, layout, sample, beginAbort, sampleAbort, reset, update, prewarm,
    get visible() { return stage.visible; },
    model, accent, parts,
    dispose() { model.dispose(); accent.dispose(); shadow.geometry.dispose(); shadow.material.map.dispose(); shadow.material.dispose(); },
  };
}

// Soft round contact shadow (the same decal index.js uses for Therma-Shift).
function contactShadow(size) {
  const c = document.createElement('canvas'); c.width = c.height = 128;
  const g = c.getContext('2d'), grd = g.createRadialGradient(64, 64, 8, 64, 64, 62);
  grd.addColorStop(0, 'rgba(0,0,0,1)'); grd.addColorStop(.45, 'rgba(0,0,0,.55)'); grd.addColorStop(1, 'rgba(0,0,0,0)');
  g.fillStyle = grd; g.fillRect(0, 0, 128, 128);
  const tex = new THREE.CanvasTexture(c);
  const m = new THREE.Mesh(new THREE.PlaneGeometry(size, size), new THREE.MeshBasicMaterial({ map: tex, color: 0x1a1c20, transparent: true, opacity: 0, depthWrite: false }));
  m.rotation.x = -Math.PI / 2; m.renderOrder = -1;
  return m;
}
