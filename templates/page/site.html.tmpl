<script>
  // Phone menu, same behavior as websites.html (js/website-inquiry.js): a native modal dialog,
  // so focus stays inside and Escape closes it.
  (function () {
    var menu = document.getElementById('site-menu'), btn = document.getElementById('open-menu');
    if (!menu || !btn || typeof menu.showModal !== 'function') return;
    var overflow = '';
    btn.onclick = function () { if (menu.open) return; overflow = document.body.style.overflow; document.body.style.overflow = 'hidden'; menu.showModal(); btn.setAttribute('aria-expanded', 'true'); };
    document.getElementById('close-menu').onclick = function () { menu.close(); };
    menu.addEventListener('close', function () { document.body.style.overflow = overflow; btn.setAttribute('aria-expanded', 'false'); btn.focus({ preventScroll: true }); });
    menu.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { menu.close(); }); });
    matchMedia('(min-width: 861px)').addEventListener('change', function (e) { if (e.matches && menu.open) menu.close(); });
  })();
</script>
