/* {{KEY}}: section spacing in the Studio rhythm (same clamp() pattern as .exp and .beyond).
   Add to next/css/studio.css next to the other section blocks. */
.{{KEY}} { padding: clamp(60px, 8vw, 120px) 0 clamp(60px, 8vw, 120px); }
.{{KEY}}__body { max-width: 62ch; font-size: clamp(16px, 1.2vw, 19px); line-height: 1.55; }
